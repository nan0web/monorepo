{
  "name": "@nan0web/monorepo",
  "version": "3.3.0",
  "description": "Monorepo for @nan0web packages and applications",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "rm -rf types/",
    "build": "tsc",
    "clean": "rm -rf .cache/ && rm -rf dist/",
    "clean:modules": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "test": "node --test --test-timeout=3333 \"src/**/*.test.js\"",
    "test:stories": "node --test --test-timeout=3333 \"src/**/*.story.js\"",
    "test:docs": "node --test src/README.md.js",
    "test:release": "node --test releases/1/0/v1.0.0/**/*.test.js | grep #TODO",
    "test:status": "node bin/packages-status.js",
    "test:audit": "node bin/audit.js",
    "test:all": "npm run test && npm run test:stories && npm run test:docs",
    "test:every": "pnpm -r --no-bail --workspace-concurrency=4 run test:all",
    "test:changed": "pnpm -r --filter \"...[HEAD]\" run test:all",
    "test:failed": "pnpm -r run test:all --reporter-hide-passed",
    "fix:all": "pnpm -r exec npm run lint --fix || pnpm run lint:fix",
    "dev:setup": "pnpm install && pnpm -r install",
    "dev:all": "pnpm -r run dev",
    "build:all": "pnpm -r run build",
    "build:changed": "pnpm -r --filter \"...[HEAD]\" run build",
    "docs:gen": "node scripts/gen-docs.js",
    "ai:index": "pnpm --filter @nan0web/ai run index",
    "ai:setup": "pnpm --filter @nan0web/ai run mcp:install",
    "ai:search": "pnpm --filter @nan0web/ai run search",
    "ai": "pnpm --filter @nan0web/ai run nan0ai",
    "release:check": "node scripts/release-status.js",
    "release:check-app": "node scripts/release-status.js --app",
    "release:bump": "node packages/release/bin/nan0release.js bump",
    "lint": "prettier --check . --ignore-path .prettierignore",
    "lint:fix": "prettier --write . --ignore-path .prettierignore",
    "precommit": "npm test",
    "prepush": "npm test",
    "prepare": "husky",
    "test:indexator": "node bin/indexator.js",
    "test:index": "node bin/indexator.js",
    "test:workflow-index": "node --test src/domain/app/WorkflowIndexApp.story.js",
    "gen:workflow-index": "node bin/workflow-index.js docs/uk/workflows && node bin/workflow-index.js docs/en/workflows",
    "test:validate": "node bin/project-validator.js",
    "task:prepare": "node bin/task-prepare.js",
    "task:rename-pipelines": "node scripts/rename-pipelines.js"
  },
  "keywords": [],
  "author": "ЯRаСлав YaRaSLove <support@yaro.page>",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@lit/reactive-element": "^2.1.2",
    "@nan0web/co": "workspace:*",
    "@nan0web/core": "workspace:*",
    "@nan0web/db": "workspace:*",
    "@nan0web/db-fs": "workspace:*",
    "@nan0web/i18n": "workspace:*",
    "@nan0web/inspect": "workspace:*",
    "@nan0web/llimo.app": "workspace:*",
    "@nan0web/log": "workspace:*",
    "@nan0web/markdown": "workspace:*",
    "@nan0web/test": "workspace:*",
    "@nan0web/types": "workspace:*",
    "@nan0web/ui": "workspace:*",
    "@nan0web/ui-cli": "workspace:*",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lit": "^3.3.2",
    "lit-element": "^4.2.2",
    "lit-html": "^3.3.2",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.41",
    "@react-input/mask": "^2.0.4",
    "ai": "^5.0.150",
    "madge": "^8.0.0",
    "micromatch": "^4.0.8",
    "openai": "^6.27.0",
    "prop-types": "^15.8.1",
    "react-bootstrap": "^2.10.10",
    "react-icons": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "hnswlib-node",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "ip-address": "^10.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "react": "19.2.5",
      "react-dom": "19.2.5",
      "vitest@<4.1.0": ">=4.1.0",
      "react-router@>=7.0.0 <=7.14.1": ">=7.14.2",
      "react-router@>=7.0.0 <7.14.1": ">=7.14.1",
      "react-router@>=7.0.0 <7.15.0": ">=7.15.0",
      "hono@<4.12.21": ">=4.12.21",
      "shell-quote@>=1.1.0 <=1.8.3": ">=1.8.4",
      "joi@>=18.0.0 <18.2.1": ">=18.2.1",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@<=6.4.2": ">=6.4.3",
      "vite@>=7.0.0 <=7.3.4": ">=7.3.5",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "nodemailer@<=8.0.8": ">=8.0.9",
      "nodemailer@<=8.0.7": ">=8.0.8",
      "hono@<4.12.25": ">=4.12.25",
      "nodemailer@<=9.0.0": ">=9.0.1",
      "typescript": "5.9.3"
    }
  }
}
