{
  "name": "@nan0web/ui-next",
  "version": "3.2.0",
  "description": "Next.js App Router Adapter for the NaN0Web OLMUI ecosystem",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "clean": "rm -rf dist/",
    "build": "tsc && find dist -name '*.js' -exec sed -i '' \"s/\\.jsx'/\\.js'/g; s/\\.jsx\\\"/\\.js\\\"/g\" {} +",
    "test:release": "node --import tsx --test \"releases/**/*.test.js\" \"src/test/releases/**/*.test.js\"",
    "release:spec": "node --import tsx --test \"releases/**/*.spec.js\"",
    "release:verify": "node --import tsx --test \"src/test/releases/**/*.test.js\"",
    "test:unit": "node --import tsx --test \"play/**/*.spec.js\" \"src/**/*.test.js\"",
    "test:all": "npm run test:unit && npm run build && npm run release:verify",
    "test": "npm run test:unit",
    "play": "vite",
    "play:build": "vite build"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  },
  "keywords": [
    "nan0web",
    "olmui",
    "nextjs",
    "db-fs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@nan0web/db-fs": "workspace:*",
    "@nan0web/types": "workspace:*",
    "@nan0web/ui": "workspace:*",
    "@uiw/react-md-editor": "^4.1.1",
    "js-yaml": "^4.3.0"
  }
}
