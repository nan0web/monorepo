name: "@nan0web/ui"
agents:
  - id: adapter-architect
    description: UI Adapter Creation (Step 4)
    workflows:
      - docs/uk/workflows/pipeline-no4-adapter.md
  - id: ui-web-architect
    description: UI-WEB Interface Creation (Step 7)
    workflows:
      - docs/uk/workflows/pipeline-no7-ui-web.md
    inspectors:
      - docs/uk/inspectors/inspect-web.md
  - id: ui-mobile-architect
    description: UI-MOBILE Interface Creation (Step 8)
    workflows:
      - docs/uk/workflows/pipeline-no8-ui-mobile.md
  - id: olm-architect
    description: "OLMUI Architecture & Adapters"
    workflows:
      - docs/uk/workflows/olm-ui-architecture.md
      - docs/uk/workflows/olm-ui-architecture-core.md
      - docs/uk/workflows/olm-ui-architecture-adapters.md
      - docs/uk/workflows/olm-ui-architecture-i18n.md
      - docs/uk/workflows/olm-ui-architecture-testing.md
      - docs/uk/workflows/olm-ui-examples.md
      - docs/uk/workflows/nan0web-v2-roadmap.md
      - docs/uk/workflows/nan0web.md
      - docs/uk/workflows/architecture.md
  - id: component-forge
    description: "UI Component Generation & Welding"
    workflows:
      - docs/uk/workflows/forge-component.md
      - docs/uk/workflows/ui-update.md
      - docs/uk/workflows/interface-welding.md
    inspectors:
      - docs/uk/inspectors/prop-welder.md
