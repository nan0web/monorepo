{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"emitDeclarationOnly": false,
		"rootDir": ".",
		"checkJs": false,
		"allowJs": true
	},
	"include": [
		"src/**/*",
		"releases/**/*.js"
	],
	"exclude": [
		"node_modules",
		"types",
		"src/**/*.test.js",
		"src/README.md.js",
		"releases/**/*.spec.js"
	]
}
