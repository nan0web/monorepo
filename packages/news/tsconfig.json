{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"lib": [
			"esnext",
			"dom"
		],
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": true,
		"outDir": "./types",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "nodenext",
		"allowSyntheticDefaultImports": true,
		"noImplicitAny": false,
		"allowJs": true,
		"checkJs": false,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"node_modules",
		"src/collections/**",
		"**/*.test.js",
		"**/*.story.js",
		"**/README.md.js",
		"src/test"
	]
}
