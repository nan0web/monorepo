{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/index.js",
    "src/access.js",
    "src/templates/PayloadCollectionTemplate.js",
    "src/domain/index.js",
    "src/domain/CollectionBuilder.js",
    "src/domain/PayloadApp.js",
    "src/domain/SeedModel.js",
    "src/components/*.jsx",
    "play/main.js"
  ],
  "project": [
    "src/**/*.js",
    "src/**/*.jsx",
    "play/**/*.js",
    "play/**/*.jsx"
  ],
  "ignoreDependencies": [
    "@nan0web/types",
    "@payloadcms/ui",
    "payload"
  ],
  "rules": {
    "duplicates": "off"
  }
}
