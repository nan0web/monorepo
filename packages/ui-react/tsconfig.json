{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"lib": [
			"esnext",
			"dom"
		],
		"declaration": true,
		"declarationMap": false,
		"emitDeclarationOnly": true,
		"outDir": "./types",
		"rootDir": "./src",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "node",
		"allowSyntheticDefaultImports": true,
		"noImplicitAny": false,
		"allowJs": true,
		"checkJs": false,
		"types": [],
		"jsx": "react-jsx",
		"baseUrl": ".",
		"paths": {
			"@nan0web/*": [
				"../*/types",
				"../*/types/index.d.ts",
				"../*/types/index.js"
			]
		}
	},
	"include": [
		"src/index.jsx",
		"src/Element.jsx",
		"src/UIReact.jsx",
		"src/UIRoot.jsx",
		"src/components/**/*.js",
		"src/components/**/*.jsx",
		"src/context/**/*.js",
		"src/context/**/*.jsx",
		"src/hooks/**/*.js",
		"src/hooks/**/*.jsx",
		"src/models/**/*.js",
		"src/renderers/**/*.js",
		"src/renderers/**/*.jsx",
		"src/vite/**/*.js"
	],
	"exclude": [
		"node_modules",
		"types",
		"dist",
		"src/**/*.test.js",
		"src/**/*.test.jsx",
		"src/README.md.js",
		"src/README.md.jsx",
		"src/apps"
	]
}
