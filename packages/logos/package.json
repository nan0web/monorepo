{
  "name": "@nan0web/logos",
  "version": "3.4.0",
  "description": "Sovereign Logic Hub: Intent, Observer, and Identity models.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./intent": {
      "import": "./src/domain/intent/index.js",
      "types": "./types/domain/intent/index.d.ts"
    },
    "./observer": {
      "import": "./src/domain/observer/index.js",
      "types": "./types/domain/observer/index.d.ts"
    },
    "./identity": {
      "import": "./src/domain/identity/index.js",
      "types": "./types/domain/identity/index.d.ts"
    }
  },
  "scripts": {
    "test": "node --test \"src/**/*.test.js\"",
    "prebuild": "rm -rf types",
    "build": "tsc",
    "knip": "knip --production",
    "inspect": "nan0inspect --non-interactive",
    "test:all": "npm run test && npm run build && npm run knip"
  },
  "author": "ЯRаСлав (YaRaSLove) <support@yaro.page>",
  "license": "ISC",
  "dependencies": {
    "@nan0web/co": "workspace:*",
    "@nan0web/types": "workspace:*"
  },
  "devDependencies": {
    "@nan0web/test": "workspace:*",
    "knip": "^5.88.1",
    "typescript": "^5.9.3"
  },
  "files": [
    "src/**/*.js",
    "!src/**/*.test.js",
    "types/**/*.d.ts",
    "LICENSE",
    "README.md"
  ]
}
