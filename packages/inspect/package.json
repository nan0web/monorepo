{
  "name": "@nan0web/inspect",
  "version": "3.11.0",
  "description": "Engineering inspection and quality control for the NaN0Web ecosystem.",
  "type": "module",
  "files": [
    "bin",
    "src/**/*.js",
    "!src/**/*.test.js",
    "!src/test/**",
    "!src/docs/**",
    "types",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.js",
  "bin": {
    "nan0inspect": "./bin/inspect.js"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./ui/cli": {
      "import": "./src/cli.js",
      "types": "./types/cli.d.ts"
    },
    "./domain/AuditorModel": {
      "import": "./src/domain/AuditorModel.js",
      "types": "./types/domain/AuditorModel.d.ts"
    },
    "./domain/modules/ModuleRegistry": {
      "import": "./src/domain/modules/ModuleRegistry.js",
      "types": "./types/domain/modules/ModuleRegistry.d.ts"
    },
    "./domain/config/InspectConfig": {
      "import": "./src/domain/config/InspectConfig.js",
      "types": "./types/domain/config/InspectConfig.d.ts"
    },
    "./domain/ast/FastApiDiscovery": {
      "import": "./src/domain/ast/FastApiDiscovery.js",
      "types": "./types/domain/ast/FastApiDiscovery.d.ts"
    }
  },
  "scripts": {
    "prebuild": "rm -rf types/",
    "build": "tsc",
    "inspect": "node bin/inspect.js",
    "test": "node --test --test-timeout=3333 src/**/*.test.js",
    "test:stories": "node --test --test-timeout=3333 'src/domain/**/*.story.js'",
    "test:docs": "node --test --test-timeout=3333 'src/docs/**/*.md.js'",
    "test:coverage": "c8 node --test",
    "play": "nan0cli --data play",
    "release:spec": "node --test releases/**/**/*.spec.js",
    "release:validate": "node bin/inspect.js release --non-interactive",
    "test:release": "node --test src/test/releases/**/**/*.test.js",
    "lint": "prettier --check \"src/**/*.js\"",
    "lint:fix": "prettier --write \"src/**/*.js\"",
    "knip": "knip --production || true",
    "test:all": "npm run test && npm run test:stories && npm run test:release && npm run test:docs && npm run build && npm run lint && npm run knip && npm run release:validate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nan0web/core": "workspace:*",
    "@nan0web/icons": "workspace:*",
    "@nan0web/markdown": "workspace:*",
    "@nan0web/types": "workspace:*",
    "@nan0web/ui": "workspace:*",
    "madge": "^8.0.0"
  },
  "devDependencies": {
    "@nan0web/db": "workspace:*",
    "@nan0web/db-fs": "workspace:*",
    "c8": "^11.0.0",
    "knip": "^5.88.1",
    "typescript": "^5.0.0"
  }
}
