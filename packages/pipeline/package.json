{
  "name": "@nan0web/pipeline",
  "version": "3.4.0",
  "type": "module",
  "description": "Abstract Node-based Pipeline Architecture for NanoWeb",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./Node": {
      "types": "./types/Node.d.ts",
      "import": "./src/Node.js"
    },
    "./Pipeline": {
      "types": "./types/Pipeline.d.ts",
      "import": "./src/Pipeline.js"
    }
  },
  "files": [
    "src/**/*.js",
    "!src/**/*.test.js",
    "!src/README.md.js",
    "types/**/*.d.ts"
  ],
  "scripts": {
    "prebuild": "rm -rf types/",
    "build": "tsc",
    "test": "node --test \"src/**/*.test.js\"",
    "lint": "prettier --check \"src/**/*.js\"",
    "lint:fix": "prettier --write \"src/**/*.js\"",
    "knip": "knip --production",
    "test:all": "npm run test && npm run build && npm run lint && npm run knip",
    "audit": "pnpm audit --prod || true",
    "precommit": "npm test"
  },
  "keywords": [
    "nan0web",
    "pipeline",
    "node-based",
    "workflow"
  ],
  "author": "nan0web",
  "license": "ISC",
  "dependencies": {
    "@nan0web/types": "workspace:*"
  },
  "devDependencies": {
    "knip": "^5.88.1"
  }
}
