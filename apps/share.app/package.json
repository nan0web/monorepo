{
  "name": "@nan0web/share.app",
  "version": "3.1.1",
  "description": "Sovereign Social Distribution Layer (Rules Engine)",
  "type": "module",
  "main": "src/index.js",
  "license": "ISC",
  "author": "nan0web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan0web/share.app.git"
  },
  "keywords": [
    "social",
    "distribution",
    "rules-engine",
    "telegram",
    "publish",
    "nan0web"
  ],
  "scripts": {
    "start": "node src/index.js",
    "prebuild": "rm -rf dist types",
    "build": "tsc",
    "test": "node --test \"src/**/*.spec.js\"",
    "test:docs": "node --test src/README.md.js",
    "test:integration": "node --test \"src/test/releases/**/*.test.js\"",
    "test:release": "node --test \"src/test/releases/**/*.test.js\"",
    "release:spec": "node --test \"src/test/releases/**/*.spec.js\"",
    "test:coverage": "c8 node --test",
    "test:all": "npm run build && npm run test && npm run test:docs && npm run test:integration && npm run knip",
    "knip": "knip --production",
    "play": "node play/main.js",
    "download": "node bin/download-whisper.js",
    "audit": "pnpm audit --prod || true"
  },
  "devDependencies": {
    "@nan0web/db-fs": "workspace:*",
    "@nan0web/test": "workspace:*",
    "c8": "^10.1.3",
    "knip": "^5.85.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@nan0web/ai": "workspace:*"
  }
}
