{
  "name": "@nan0web/nan0web.app",
  "version": "3.1.1",
  "description": "Sovereign OLMUI Engine — High-performance, data-driven runner for the NaN•Web ecosystem with architectural boot security.",
  "author": "ЯRаСлав <support@yaro.page>",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/nan0web/nan0web.app.git"
  },
  "private": false,
  "type": "module",
  "bin": {
    "nan0web": "./bin/nan0web"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    },
    "./ui/cli": {
      "import": "./src/ui/cli/index.js",
      "types": "./types/ui/cli/index.d.ts"
    },
    "./ui/lit": {
      "import": "./src/ui/lit/app.js"
    },
    "./ui/vscode": {
      "import": "./src/ui/vscode/src/NaN0Editor.js"
    },
    "./ui/vscode-nan0": {
      "import": "./src/ui/vscode-nan0/src/extension.js"
    }
  },
  "scripts": {
    "start": "node bin/nan0web",
    "prebuild": "rm -rf dist types",
    "build": "tsc",
    "knip": "knip --production --no-exit-code",
    "play": "node play/main.js",
    "test": "node --test \"src/**/*.test.js\"",
    "test:docs": "node --test \"src/README.md.js\"",
    "test:stories": "node --test \"test/stories/*.story.js\"",
    "test:play": "UI_SNAPSHOT=1 node --test --test-concurrency=1 --test-timeout=15000 \"test/play/**/*.test.js\"",
    "test:gallery": "npx nan0gallery --dir=snapshots/cli --out=CLI_GALLERY.md",
    "test:all": "npm run build && npm run test && npm run test:stories && npm run knip",
    "test:release": "node --test src/test/releases/**/**/*.test.js",
    "release:spec": "node --test \"releases/**/*.spec.js\"",
    "release:verify": "npm run test:all && npm run release:spec",
    "test:coverage": "c8 node --test"
  },
  "dependencies": {
    "@nan0web/db-browser": "workspace:*",
    "@nan0web/db-fs": "workspace:*",
    "@nan0web/http-node": "workspace:*",
    "@nan0web/i18n": "workspace:*",
    "@nan0web/markdown": "workspace:*",
    "@nan0web/types": "workspace:*",
    "@nan0web/ui": "workspace:*",
    "@nan0web/ui-cli": "workspace:*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "knip": "^5.86.0",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "@playwright/test": "^1.58.2"
  }
}